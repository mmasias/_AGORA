@startuml

skinparam component {
  BorderColor<<construido>> #2E7D32
  BorderColor<<fase2>> #F9A825
  BorderColor<<fase3>> #D84315
  BorderColor<<externo>> #757575
  BackgroundColor<<construido>> #C8E6C9
  BackgroundColor<<fase2>> #FFF9C4
  BackgroundColor<<fase3>> #FFCCBC
  BackgroundColor<<externo>> #E0E0E0
}

' === Fuentes ===

component "CELDA" <<construido>> as CELDA
component "ERP de la universidad\nGUIAA / AGORA" <<externo>> as ERP

component "ORCID" <<externo>> as ORCID
component "CrossRef" <<externo>> as CROSSREF

' === Satelites Fase II ===

component "MERITOS" <<fase2>> as MERITOS
component "PULSO" <<fase2>> as PULSO
component "VITRINA" <<fase2>> as VITRINA
component "CITA" <<fase2>> as CITA
component "CARGA" <<fase2>> as CARGA
component "PRISMA" <<fase2>> as PRISMA

' === Satelites Fase III ===

component "SIGHOR" <<fase3>> as SIGHOR
component "ASISTE" <<fase3>> as ASISTE
component "FEDATARIO" <<fase3>> as FEDATARIO
component "ACTIVITAT" <<fase3>> as ACTIVITAT

' === Consumos sobre CELDA ===

PULSO -up-> CELDA : <sub>catalogo</sub>
VITRINA -up-> CELDA : <sub>guias aprobadas</sub>
CARGA -up-> CELDA : <sub>sesiones de evaluacion</sub>
ASISTE -up-> CELDA : <sub>sesiones y catalogo</sub>
SIGHOR -up-> CELDA : <sub>catalogo</sub>
ACTIVITAT -up-> CELDA : <sub>imparticiones</sub>
FEDATARIO -up-> CELDA : <sub>guias aprobadas por curso</sub>
PRISMA -up-> CELDA : <sub>estado de las guias</sub>

' === CELDA sobre satelites ===

CELDA -down-> CITA : <sub>buscar / dar de alta referencias</sub>\n<sub>(CELDA copia la referencia)</sub>

' === Satelite a satelite ===

CARGA -up-> SIGHOR : <sub>sesiones por semana</sub>
ASISTE -up-> SIGHOR : <sub>grupos, aula y franja</sub>
PRISMA -up-> MERITOS
PRISMA -up-> PULSO
PRISMA -up-> ASISTE
PRISMA -up-> CARGA
PRISMA -up-> ACTIVITAT

' === Consumos sobre el ERP de la universidad ===

FEDATARIO -up-> ERP : <sub>itinerario del alumno</sub>

ERP -d[hidden]- CELDA

' === Extensiones previstas ===

PULSO .up.> ERP : <sub>censo de alumnos (v2)</sub>
ACTIVITAT .up.> ASISTE : <sub>tutorias (fase 2)</sub>
MERITOS .up.> ORCID : <sub>importar publicaciones</sub>
CITA .up.> CROSSREF : <sub>alta de referencias por DOI</sub>
CELDA ..> MERITOS : <sub>breve descripcion del profesor (por decidir)</sub>

legend left
  | Color | Estado |
  |<#C8E6C9>| construido |
  |<#FFF9C4>| Fase II |
  |<#FFCCBC>| Fase III |
  |<#E0E0E0>| sistema externo |
  Linea continua: dependencia desde la v1
  Linea discontinua: extension prevista
end legend
@enduml
