@startuml

hide stereotype
left to right direction

skinparam component {
  BorderColor<<existente>> #00695C
  BorderColor<<construido>> #2E7D32
  BorderColor<<fase2_baja>> #F9A825
  BorderColor<<fase2_media>> #F9A825
  BorderColor<<fase2_alta>> #F57F17
  BorderColor<<fase3_baja>> #D84315
  BorderColor<<fase3_media>> #D84315
  BorderColor<<fase3_alta>> #BF360C
  BorderColor<<externo>> #757575
  BackgroundColor<<existente>> #B2DFDB
  BackgroundColor<<construido>> #C8E6C9
  BackgroundColor<<fase2_baja>> #FFF9C4
  BackgroundColor<<fase2_media>> #FFEE58
  BackgroundColor<<fase2_alta>> #FBC02D
  BackgroundColor<<fase3_baja>> #FFCCBC
  BackgroundColor<<fase3_media>> #FF8A65
  BackgroundColor<<fase3_alta>> #E64A19
  BackgroundColor<<externo>> #E0E0E0
}

package UNIVERSO_CONOCIDO {

  ' === Sistemas ya construidos de la organizacion (se consumen, no se construyen aqui) ===

  component "SISTEMAS\n\n<b>ERP</b>s: SG / GUIAA / AGORA\n\n<b>LMS</b>: PANAL & CAMPUS" <<existente>> as ERP

  ' === Lo que se construye aqui ===

  package ECOSISTEMA_CELDA {

    component "CELDA" <<construido>> as CELDA

    ' === Satelites Fase II ===

    component "MERITOS" <<fase2_media>> as MERITOS
    component "PULSO" <<fase2_media>> as PULSO
    component "VITRINA" <<fase2_baja>> as VITRINA
    component "CITA" <<fase2_baja>> as CITA
    component "CARGA" <<fase2_media>> as CARGA
    component "PRISMA" <<fase2_alta>> as PRISMA

    ' === Satelites Fase III ===

    component "SIGHOR" <<fase3_alta>> as SIGHOR
    component "ASISTE" <<fase3_media>> as ASISTE
    component "FEDATARIO" <<fase3_alta>> as FEDATARIO
    component "ACTIVITAT" <<fase3_baja>> as ACTIVITAT

  }

}

package EXTRAVERSO {
  component "ORCID" <<externo>> as ORCID
  component "CrossRef" <<externo>> as CROSSREF

}


' === Consumos sobre CELDA ===

PULSO -up-> CELDA
VITRINA -up-> CELDA
CARGA -up-> CELDA
SIGHOR -up-> CELDA
ACTIVITAT -up-> CELDA
FEDATARIO -up-> CELDA
PRISMA -up-> CELDA

' === CELDA sobre satelites ===

CELDA .down.> CITA

' === Satelite a satelite ===

PRISMA .up.> MERITOS
PRISMA .up.> PULSO
PRISMA .up.> ASISTE
PRISMA .up.> CARGA
PRISMA .up.> ACTIVITAT

' === Consumos sobre el ERP de la universidad ===

FEDATARIO -up-> ERP
SIGHOR -up-> ERP

' === Extensiones previstas ===

ASISTE .up.> CELDA
CELDA .up.> ERP
PULSO .up.> ERP
PRISMA .up.> ERP
ACTIVITAT .up.> ASISTE
MERITOS ...down.> ORCID
CITA ..down.> CROSSREF
CELDA ..> MERITOS

legend right
| Color | Estado |
|<#B2DFDB>| Existente |
|<#C8E6C9>| Construido |
|<#FFEE58>| Fase II |
|<#FF8A65>| Fase III |
|<#E0E0E0>| Sistema de terceros |
Tono: mas claro = mas sencillo, mas intenso = mas complejo
UNIVERSO_CONOCIDO: nosotros
EXTRAVERSO: terceros
<i>Linea continua: dependencia desde la v1</i>
<i>Linea discontinua: dependencia opcional, prevista o pendiente de decidir</i>
end legend
@enduml
